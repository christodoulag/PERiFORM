distance2=find(ppsdata{k}(:,1)==0.75);
distance3=find(ppsdata{k}(:,1)==1.25);
distance4=find(ppsdata{k}(:,1)==1.75);
distance5=find(ppsdata{k}(:,1)==2.25);

